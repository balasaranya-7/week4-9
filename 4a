
import 'package:flutter/material.dart';

void main() => runApp(const MyNavigationApp());

class MyNavigationApp extends StatelessWidget {
  const MyNavigationApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      initialRoute: '/',
      routes: {
        '/': (context) => const HomeScreen(),
        '/Screen1': (context) => const Screen1(),
        '/contact': (context) => const ContactScreen(),
      },
      onUnknownRoute: (settings) => MaterialPageRoute(
        builder: (context) => const UnknownScreen(),
      ),
    );
  }
}

class HomeScreen extends StatelessWidget {
  const HomeScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Home')),
      body: Container(
        color: Colors.teal.shade100,
        width: double.infinity,
        padding: const EdgeInsets.all(16),
        child: Column(
          children: [
            const Text('This is the Home Screen'),
            const SizedBox(height: 20),

            ElevatedButton(
              onPressed: () => Navigator.push(context,
                MaterialPageRoute(builder: (_) => const Screen1())),
              child: const Text('Go to Screen1 (push)'),
            ),

            ElevatedButton(
              onPressed: () => Navigator.pushNamed(context, '/contact'),
              child: const Text('Go to Contact (named route)'),
            ),

            ElevatedButton(
              onPressed: () {
                Navigator.pushReplacementNamed(context, '/Screen1');
              },
              child: const Text('Replace with Screen1'),
            ),

            ElevatedButton(
              onPressed: () async {
                final result = await Navigator.push(
                  context,
                  MaterialPageRoute(builder: (_) => const ReturnScreen()),
                );
                if (context.mounted && result != null) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(content: Text('Returned: $result')),
                  );
                }
              },
              child: const Text('Go to Return Screen'),
            ),

            ElevatedButton(
              onPressed: () => Navigator.pushNamed(context, '/invalid'),
              child: const Text('Go to Unknown Route'),
            ),
          ],
        ),
      ),
    );
  }
}

class Screen1 extends StatelessWidget {
  const Screen1({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Screen1')),
      backgroundColor: Colors.yellow.shade100,
      body: const Center(child: Text('This is the Screen1')),
    );
  }
}

class ContactScreen extends StatelessWidget {
  const ContactScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Contact')),
      backgroundColor: Colors.red.shade100,
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Text('This is the Contact Screen'),
            const SizedBox(height: 20),
            ElevatedButton(
              onPressed: () =>
                Navigator.popUntil(context, ModalRoute.withName('/')),
              child: const Text('Go back to Home (popUntil)'),
            ),
          ],
        ),
      ),
    );
  }
}

class ReturnScreen extends StatelessWidget {
  const ReturnScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Return Data Screen')),
      backgroundColor: Colors.blue.shade100,
      body: Center(
        child: ElevatedButton(
          onPressed: () => Navigator.pop(context, 'Hello!'),
          child: const Text('Return "Hello!" to Home'),
        ),
      ),
    );
  }
}

class UnknownScreen extends StatelessWidget {
  const UnknownScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Unknown Route')),
      backgroundColor: Colors.grey.shade300,
      body: const Center(
        child: Text(
          '404 - Page Not Found',
          style: TextStyle(fontSize: 22, color: Colors.red),
        ),
      ),
    );
  }
}
